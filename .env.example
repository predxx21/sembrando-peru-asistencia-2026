# =====================================================
# Variables de entorno — Asistencia Sembrando Perú
#
# Copia este archivo a `.env` y `.env.local` (según la
# sección de cada variable) y completa los valores.
# NUNCA subas a git los archivos reales (.env, .env.local).
# =====================================================

# --- PostgreSQL (Prisma) — va en `.env` ---
# Cadena de conexión a la base de datos de Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# URL del pooler de Supabase (modo sesión o transacción). Si no se
# define, Prisma usa DATABASE_URL. Ver lib/db/client.js para el tuning.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# --- Supabase Auth + Storage — va en `.env.local` ---
# URL del proyecto (Supabase → Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Clave pública (anon) del proyecto. Es segura publicarla al cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJ..."

# Clave de servicio (service_role). SOLO en el servidor: con ella se
# firman las URLs de evidencia. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Opcional ---
# Pool rápido experimental de Prisma (connection_limit=1, sin pgbouncer).
# Útil solo para desarrollo local con la piscina limpia; ver lib/db/client.js.
# USE_FAST_POOL=1
